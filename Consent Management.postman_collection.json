{
	"info": {
		"_postman_id": "f9da2cca-7aa5-4146-85cf-9898678b51c0",
		"name": "Consent Management - Registry A2C Copy",
		"description": "Consent Management APIs on OpenG2P/Odoo Registry for the A2C loan flow.\n\n**Base URL:** `https://registry.oanstaging.com` (database: `odoo`)\n\n**End-to-end flow**\n1. **login** — authenticate and establish session cookie\n2. **search farmer** — look up farmer by registration ID\n3. **request otp** — trigger Fayda OTP for the farmer\n4. **list OTP webhooks** / **fetch latest OTP webhook** — read OTP from `otp/` folder\n5. **verify otp** — verify Fayda OTP using `transaction_id` + `otp_code`\n6. **upload attachment** — upload PDF for consent record\n7. **create consent** — create a pending consent request\n8. **approve** — approve consent; registry publishes farmer data via WebSub\n9. **list farmer webhooks** / **fetch latest farmer webhook** — read payload from `respone/`\n\n**Webhook bucket (public S3 website)**\n- OTP callbacks: http://a2c-webhook.s3-website.ap-south-1.amazonaws.com/otp/\n- Farmer data after approval: http://a2c-webhook.s3-website.ap-south-1.amazonaws.com/respone/\n\nSee `consent_management_postman_registry_a2c.md` for full documentation.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "55228032",
		"_collection_link": "https://eldhomathew51248-3600859.postman.co/workspace/Eldho-Mathew's-Workspace~a649fcdc-87b2-4114-84ff-c09d8e2208eb/collection/55228032-f9da2cca-7aa5-4146-85cf-9898678b51c0?action=share&source=collection_link&creator=55228032"
	},
	"item": [
		{
			"name": "Registry API",
			"item": [
				{
					"name": "1. login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var cookies = pm.cookies.toObject();",
									"if (cookies['session_id']) {",
									"    pm.environment.set(\"session_id\", cookies['session_id']);",
									"    console.log(\"Session saved:\", cookies['session_id']);",
									"} else {",
									"    console.log(\"No session found\");",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"db\": \"{{db}}\",\n    \"login\": \"{{login}}\",\n    \"password\": \"{{password}}\"\n  }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/web/session/authenticate",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"web",
								"session",
								"authenticate"
							]
						},
						"description": "Authenticate against the Odoo registry database and store the session cookie for subsequent requests."
					},
					"response": []
				},
				{
					"name": "2.search farmer",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const response = pm.response.json();",
									"",
									"pm.test(\"OTP request successful\", function () {",
									"    pm.expect(response.result.success).to.eql(true);",
									"});",
									"",
									"pm.test(\"Response contains farmer data\", function () {",
									"    pm.expect(response.result.data.farmers.length).to.be.above(0);",
									"});",
									"",
									"// Get farmer id",
									"const farmerId = response.result.data.farmers[0].id;",
									"",
									"// Save to environment variable",
									"pm.environment.set(\"farmer_db_id\", farmerId);",
									"",
									"console.log(\"Farmer ID:\", farmerId);"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"query\": \"{{farmer_query}}\"\n  }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/consent/search_farmer",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"consent",
								"search_farmer"
							]
						}
					},
					"response": []
				},
				{
					"name": "3. request otp",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Request OTP HTTP 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const json = pm.response.json();",
									"const result = json.result || {};",
									"if (result.success && result.data && result.data.transaction_id) {",
									"    pm.collectionVariables.set('transaction_id', result.data.transaction_id);",
									"}",
									"",
									"pm.test('OTP requested', function () {",
									"    pm.expect(result.success).to.eql(true);",
									"    pm.expect(result.data).to.have.property('transaction_id');",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"farmer_id\": {{farmer_db_id}}\n  }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/consent/fayda/request_otp",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"consent",
								"fayda",
								"request_otp"
							]
						},
						"description": "Request a Fayda OTP for the farmer. The OTP is delivered to the configured webhook bucket root. Use the webhook helper requests to retrieve it."
					},
					"response": []
				},
				{
					"name": "4. verify otp",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Verify OTP HTTP 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const json = pm.response.json();",
									"const result = json.result || {};",
									"pm.test('OTP verified', function () {",
									"    pm.expect(result.success).to.eql(true);",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"farmer_id\": {{farmer_db_id}},\n    \"transaction_id\": \"{{transaction_id}}\",\n    \"otp_code\": \"{{otp_code}}\"\n  }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/consent/fayda/verify_otp",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"consent",
								"fayda",
								"verify_otp"
							]
						},
						"description": "Verify the Fayda OTP. Set `transaction_id` from step 3 and `otp_code` from the webhook bucket before running."
					},
					"response": []
				},
				{
					"name": "upload attachment",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"const attachmentId = res.result?.data?.attachment_id;",
									"if (attachmentId) {",
									"    pm.collectionVariables.set('attachment_id', String(attachmentId));",
									"    console.log('attachment_id saved:', attachmentId);",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"jsonrpc\": \"2.0\",\n    \"method\": \"call\",\n    \"params\": {\n        \"attachment_base64\": \"\",\n        \"attachment_filename\": \"test.pdf\"\n    }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/consent/attachment/upload",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"consent",
								"attachment",
								"upload"
							]
						}
					},
					"response": []
				},
				{
					"name": "5. create consent",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"const data = res.result?.data || {};",
									"if (data.id) {",
									"    pm.collectionVariables.set('consent_id', String(data.id));",
									"    console.log('consent_id saved:', data.id);",
									"}",
									"if (data.consent_creation_request_id) {",
									"    pm.collectionVariables.set('consent_creation_request_id', data.consent_creation_request_id);",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"partner_id\": {{partner_id}},\n    \"farmer_db_id\": {{farmer_db_id}},\n    \"consent_type\": \"specific\",\n    \"purpose\": \"A2C data sharing for agricultural services\",\n    \"validity_from\": \"{{validity_from}}\",\n    \"validity_to\": \"{{validity_to}}\",\n    \"allowed_data_field_ids\": {{allowed_data_field_ids}},\n    \"originated_from\": \"partner\",\n    \"attachment_ids\": {{attachment_id}}\n  }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/consent/request/create",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"consent",
								"request",
								"create"
							]
						},
						"description": "Create a pending consent request. Requires an authenticated session. `partner_id` must be a consent parent partner configured for the logged-in user."
					},
					"response": []
				},
				{
					"name": "6. approve",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Approve HTTP 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const json = pm.response.json();",
									"const result = json.result || {};",
									"pm.test('Consent approved', function () {",
									"    pm.expect(result.success).to.eql(true);",
									"    pm.expect(result.data.status).to.eql('approved');",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"consent_id\": {{consent_id}}\n  }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/consent/request/approve",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"consent",
								"request",
								"approve"
							]
						},
						"description": "Approve the consent request. On success the registry publishes farmer data via WebSub to the partner webhook URL (configured to write into the S3 `respone/` folder)."
					},
					"response": []
				}
			]
		},
		{
			"name": "Webhook Helpers",
			"item": [
				{
					"name": "A. list OTP webhooks (S3)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('S3 list HTTP 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const xml = pm.response.text();",
									"const keys = [...xml.matchAll(/<Key>([^<]+)<\\/Key>/g)].map(function (m) { return m[1]; });",
									"const otpKeys = keys.filter(function (k) {",
									"    return k.startsWith('otp/') && k.endsWith('.json');",
									"}).sort();",
									"",
									"if (otpKeys.length) {",
									"    const latest = otpKeys[otpKeys.length - 1];",
									"    pm.collectionVariables.set('latest_otp_webhook_key', latest);",
									"    console.log('Latest OTP webhook key:', latest);",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{webhook_s3_api}}/?list-type=2&prefix=otp/&max-keys=50",
							"host": [
								"{{webhook_s3_api}}"
							],
							"path": [
								""
							],
							"query": [
								{
									"key": "list-type",
									"value": "2"
								},
								{
									"key": "prefix",
									"value": "otp/"
								},
								{
									"key": "max-keys",
									"value": "50"
								}
							]
						},
						"description": "List OTP callback JSON files under `otp/`. Sets `latest_otp_webhook_key` for the next request.\n\nBrowser alternative: http://a2c-webhook.s3-website.ap-south-1.amazonaws.com/otp/"
					},
					"response": []
				},
				{
					"name": "B. fetch latest OTP webhook",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('OTP webhook HTTP 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"let payload = {};",
									"try { payload = pm.response.json(); } catch (e) {}",
									"",
									"const otp = payload.otp || payload.otp_code || (payload.request && payload.request.otp);",
									"const tx = payload.transaction_id || payload.transactionID || payload.transactionId;",
									"",
									"if (otp) pm.collectionVariables.set('otp_code', String(otp));",
									"if (tx) pm.collectionVariables.set('transaction_id', String(tx));",
									"",
									"console.log('Extracted otp_code:', pm.collectionVariables.get('otp_code'));",
									"console.log('Extracted transaction_id:', pm.collectionVariables.get('transaction_id'));"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{webhook_url}}/{{latest_otp_webhook_key}}",
							"host": [
								"{{webhook_url}}"
							],
							"path": [
								"{{latest_otp_webhook_key}}"
							]
						},
						"description": "Fetch the newest OTP webhook JSON and populate `otp_code` / `transaction_id` collection variables when present."
					},
					"response": []
				},
				{
					"name": "C. list farmer webhooks (S3)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('S3 list HTTP 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const xml = pm.response.text();",
									"const keys = [...xml.matchAll(/<Key>([^<]+)<\\/Key>/g)].map(function (m) { return m[1]; });",
									"const responseKeys = keys.filter(function (k) {",
									"    return k.startsWith('respone/') && k.endsWith('.json') && k.indexOf('webhook-respone') === -1;",
									"}).sort();",
									"",
									"if (responseKeys.length) {",
									"    const latest = responseKeys[responseKeys.length - 1];",
									"    pm.collectionVariables.set('latest_farmer_webhook_key', latest.replace(/^respone\\//, ''));",
									"    console.log('Latest farmer webhook key:', latest);",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{webhook_s3_api}}/?list-type=2&prefix=respone/&max-keys=50",
							"host": [
								"{{webhook_s3_api}}"
							],
							"path": [
								""
							],
							"query": [
								{
									"key": "list-type",
									"value": "2"
								},
								{
									"key": "prefix",
									"value": "respone/"
								},
								{
									"key": "max-keys",
									"value": "50"
								}
							]
						},
						"description": "List farmer-data webhook payloads under `respone/` after consent approval.\n\nBrowser alternative: http://a2c-webhook.s3-website.ap-south-1.amazonaws.com/respone/"
					},
					"response": []
				},
				{
					"name": "D. fetch latest farmer webhook",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Farmer webhook HTTP 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const payload = pm.response.json();",
									"pm.test('Farmer webhook has consent block', function () {",
									"    pm.expect(payload).to.have.property('consent');",
									"    pm.expect(payload).to.have.property('farmer');",
									"    pm.expect(payload).to.have.property('selected_data');",
									"});"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{webhook_response_url}}/{{latest_farmer_webhook_key}}",
							"host": [
								"{{webhook_response_url}}"
							],
							"path": [
								"{{latest_farmer_webhook_key}}"
							]
						},
						"description": "Fetch the newest farmer-data webhook JSON published after consent approval."
					},
					"response": []
				}
			]
		}
	],
