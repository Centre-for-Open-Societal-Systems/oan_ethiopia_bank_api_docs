{
	"info": {
		"_postman_id": "f9da2cca-7aa5-4146-85cf-9898678b51c0",
		"name": "Consent Management - Registry A2C Copy",
		"description": "Consent Management APIs on OpenG2P/Odoo Registry for the A2C loan flow (Updated to ATI Farmer Consent APIs).\n\n**Base URL:** `https://registry.oanstaging.com` (database: `odoo`)\n\n**End-to-end flow**\n1. **login** — authenticate and establish session cookie\n2. **search farmer** — look up farmer by registration ID\n3. **request otp** — trigger Fayda OTP for the farmer\n4. **list OTP webhooks** / **fetch latest OTP webhook** — read OTP from `otp/` folder\n5. **verify otp** — verify Fayda OTP using `transaction_id` + `otp_code`\n6. **fetch consent reasons** — retrieve active consent reasons\n7. **fetch allowed data fields** — retrieve allowed fields for the partner\n8. **submit consent** — submit consent request, which automatically creates and auto-approves the consent request\n9. **list farmer webhooks** / **fetch latest farmer webhook** — read payload from `respone/` after approval\n\n**Webhook bucket (public S3 website)**\n- OTP callbacks: http://a2c-webhook.s3-website.ap-south-1.amazonaws.com/otp/\n- Farmer data after approval: http://a2c-webhook.s3-website.ap-south-1.amazonaws.com/respone/",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Registry API",
			"item": [
				{
					"name": "1. login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Login Status is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const response = pm.response.json();",
									"const result = response.result || {};",
									"if (result.partner_id) {",
									"    pm.collectionVariables.set(\"partner_id\", result.partner_id);",
									"    pm.environment.set(\"partner_id\", result.partner_id);",
									"    console.log(\"Partner ID saved:\", result.partner_id);",
									"}",
									"",
									"var cookies = pm.cookies.toObject();",
									"if (cookies['session_id']) {",
									"    pm.collectionVariables.set(\"session_id\", cookies['session_id']);",
									"    pm.environment.set(\"session_id\", cookies['session_id']);",
									"    console.log(\"Session saved:\", cookies['session_id']);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/web/session/authenticate",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"web",
								"session",
								"authenticate"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"jsonrpc\": \"2.0\",\n    \"params\": {\n        \"db\": \"{{db}}\",\n        \"login\": \"{{login}}\",\n        \"password\": \"{{password}}\"\n    }\n}"
						}
					}
				},
				{
					"name": "2. search farmer",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Search Status is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const response = pm.response.json();",
									"const result = response.result || {};",
									"const data = result.data || {};",
									"const farmers = data.farmers || [];",
									"",
									"if (farmers.length > 0) {",
									"    const farmer = farmers[0];",
									"    pm.collectionVariables.set(\"farmer_db_id\", farmer.id);",
									"    pm.collectionVariables.set(\"farmer_name\", farmer.name || \"\");",
									"    pm.collectionVariables.set(\"farmer_phone\", farmer.phone || \"\");",
									"    pm.collectionVariables.set(\"otp_identifier\", farmer.otp_identifier || \"\");",
									"    pm.collectionVariables.set(\"otp_identifier_type\", farmer.otp_identifier_type || \"\");",
									"",
									"    pm.environment.set(\"farmer_db_id\", farmer.id);",
									"    pm.environment.set(\"farmer_name\", farmer.name || \"\");",
									"    pm.environment.set(\"farmer_phone\", farmer.phone || \"\");",
									"    pm.environment.set(\"otp_identifier\", farmer.otp_identifier || \"\");",
									"    pm.environment.set(\"otp_identifier_type\", farmer.otp_identifier_type || \"\");",
									"",
									"    console.log(\"Saved Farmer Details:\", {",
									"        id: farmer.id,",
									"        name: farmer.name,",
									"        phone: farmer.phone,",
									"        otp_identifier: farmer.otp_identifier",
									"    });",
									"} else {",
									"    console.log(\"No farmer records found in search response.\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/consent/search_farmer",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"consent",
								"search_farmer"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"jsonrpc\": \"2.0\",\n    \"params\": {\n        \"farmer_id\": \"{{farmer_query_id}}\"\n    }\n}"
						}
					}
				},
				{
					"name": "3. request otp",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Request OTP Status is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const response = pm.response.json();",
									"const result = response.result || {};",
									"const data = result.data || {};",
									"",
									"if (result.success && data.transaction_id) {",
									"    const txId = data.transaction_id;",
									"    pm.collectionVariables.set(\"transaction_id\", txId);",
									"    pm.environment.set(\"transaction_id\", txId);",
									"    console.log(\"Saved Transaction ID:\", txId);",
									"} else {",
									"    console.log(\"Could not extract transaction_id from OTP response.\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/consent/fayda/request_otp",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"consent",
								"fayda",
								"request_otp"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"jsonrpc\": \"2.0\",\n    \"params\": {\n        \"farmer_id\": {{farmer_db_id}}\n    }\n}"
						}
					}
				},
				{
					"name": "4. verify otp",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Verify OTP Status is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const response = pm.response.json();",
									"const result = response.result || {};",
									"pm.test(\"OTP verification successful\", function () {",
									"    pm.expect(result.success).to.eql(true);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/consent/fayda/verify_otp",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"consent",
								"fayda",
								"verify_otp"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"jsonrpc\": \"2.0\",\n    \"params\": {\n        \"transaction_id\": \"{{transaction_id}}\",\n        \"otp\": \"{{otp_code}}\",\n        \"farmer_id\": {{farmer_db_id}}\n    }\n}"
						}
					}
				},
				{
					"name": "5. Fetch Consent Reasons",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Fetch Reasons Status is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const response = pm.response.json();",
									"const result = response.result || {};",
									"const data = result.data || [];",
									"let reasonId = 1;",
									"",
									"if (Array.isArray(data) && data.length > 0) {",
									"    reasonId = data[0].id;",
									"} else if (data.reasons && Array.isArray(data.reasons) && data.reasons.length > 0) {",
									"    reasonId = data.reasons[0].id;",
									"}",
									"",
									"pm.collectionVariables.set(\"consent_reason_id\", reasonId);",
									"pm.environment.set(\"consent_reason_id\", reasonId);",
									"console.log(\"Saved Consent Reason ID:\", reasonId);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/consent/reasons",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"consent",
								"reasons"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"jsonrpc\": \"2.0\",\n    \"params\": {}\n}"
						}
					}
				},
				{
					"name": "6. Fetch Allowed Data Fields",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Fetch Allowed Fields Status is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const response = pm.response.json();",
									"const result = response.result || {};",
									"const data = result.data || [];",
									"let fieldIds = [1];",
									"",
									"if (Array.isArray(data) && data.length > 0) {",
									"    fieldIds = [data[0].id];",
									"} else if (data.allowed_data_fields && Array.isArray(data.allowed_data_fields) && data.allowed_data_fields.length > 0) {",
									"    fieldIds = [data.allowed_data_fields[0].id];",
									"}",
									"",
									"pm.collectionVariables.set(\"allowed_data_field_ids\", JSON.stringify(fieldIds));",
									"pm.environment.set(\"allowed_data_field_ids\", JSON.stringify(fieldIds));",
									"console.log(\"Saved Allowed Data Field IDs:\", fieldIds);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/consent/allowed_data_fields",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"consent",
								"allowed_data_fields"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"jsonrpc\": \"2.0\",\n    \"params\": {\n        \"partner_id\": {{partner_id}}\n    }\n}"
						}
					}
				},
				{
					"name": "7. Submit Consent",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Submit Consent Status is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const response = pm.response.json();",
									"const result = response.result || {};",
									"pm.test(\"Consent submission successful\", function () {",
									"    pm.expect(result.success).to.eql(true);",
									"});",
									"",
									"if (result.success && result.data) {",
									"    const cId = result.data.consent_id || result.data.id;",
									"    if (cId) {",
									"        pm.collectionVariables.set(\"consent_id\", cId);",
									"        pm.environment.set(\"consent_id\", cId);",
									"        console.log(\"Saved Consent ID:\", cId);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/consent/submit_consent",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"consent",
								"submit_consent"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"jsonrpc\": \"2.0\",\n    \"params\": {\n        \"farmer_id\": {{farmer_db_id}},\n        \"consent_type\": \"{{consent_type}}\",\n        \"consent_reason_id\": {{consent_reason_id}},\n        \"validity_months\": {{validity_months}},\n        \"allowed_data_field_ids\": {{allowed_data_field_ids}},\n        \"attachment_base64\": \"{{attachment_base64}}\",\n        \"attachment_filename\": \"{{attachment_filename}}\",\n        \"fayda_otp_transaction_id\": \"{{transaction_id}}\"\n    }\n}"
						}
					}
				}
			]
		},
		{
			"name": "Webhook Helpers",
			"item": [
				{
					"name": "A. list OTP webhooks (S3)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('S3 list HTTP 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const xml = pm.response.text();",
									"const keys = [...xml.matchAll(/<Key>([^<]+)<\\/Key>/g)].map(function (m) { return m[1]; });",
									"const otpKeys = keys.filter(function (k) {",
									"    return k.startsWith('otp/') && k.endsWith('.json');",
									"}).sort();",
									"",
									"if (otpKeys.length) {",
									"    const latest = otpKeys[otpKeys.length - 1];",
									"    pm.collectionVariables.set('latest_otp_webhook_key', latest);",
									"    console.log('Latest OTP webhook key:', latest);",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{webhook_s3_api}}/?list-type=2&prefix=otp/&max-keys=50",
							"host": [
								"{{webhook_s3_api}}"
							],
							"path": [
								""
							],
							"query": [
								{
									"key": "list-type",
									"value": "2"
								},
								{
									"key": "prefix",
									"value": "otp/"
								},
								{
									"key": "max-keys",
									"value": "50"
								}
							]
						},
						"description": "List OTP callback JSON files under `otp/`. Sets `latest_otp_webhook_key` for the next request.\n\nBrowser alternative: http://a2c-webhook.s3-website.ap-south-1.amazonaws.com/otp/"
					},
					"response": []
				},
				{
					"name": "B. fetch latest OTP webhook",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('OTP webhook HTTP 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"let payload = {};",
									"try { payload = pm.response.json(); } catch (e) {}",
									"",
									"const otp = payload.otp || payload.otp_code || (payload.request && payload.request.otp);",
									"const tx = payload.transaction_id || payload.transactionID || payload.transactionId;",
									"",
									"if (otp) pm.collectionVariables.set('otp_code', String(otp));",
									"if (tx) pm.collectionVariables.set('transaction_id', String(tx));",
									"",
									"console.log('Extracted otp_code:', pm.collectionVariables.get('otp_code'));",
									"console.log('Extracted transaction_id:', pm.collectionVariables.get('transaction_id'));"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{webhook_url}}/{{latest_otp_webhook_key}}",
							"host": [
								"{{webhook_url}}"
							],
							"path": [
								"{{latest_otp_webhook_key}}"
							]
						},
						"description": "Fetch the newest OTP webhook JSON and populate `otp_code` / `transaction_id` collection variables when present."
					},
					"response": []
				},
				{
					"name": "C. list farmer webhooks (S3)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('S3 list HTTP 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const xml = pm.response.text();",
									"const keys = [...xml.matchAll(/<Key>([^<]+)<\\/Key>/g)].map(function (m) { return m[1]; });",
									"const responseKeys = keys.filter(function (k) {",
									"    return k.startsWith('respone/') && k.endsWith('.json') && k.indexOf('webhook-respone') === -1;",
									"}).sort();",
									"",
									"if (responseKeys.length) {",
									"    const latest = responseKeys[responseKeys.length - 1];",
									"    pm.collectionVariables.set('latest_farmer_webhook_key', latest.replace(/^respone\\//, ''));",
									"    console.log('Latest farmer webhook key:', latest);",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{webhook_s3_api}}/?list-type=2&prefix=respone/&max-keys=50",
							"host": [
								"{{webhook_s3_api}}"
							],
							"path": [
								""
							],
							"query": [
								{
									"key": "list-type",
									"value": "2"
								},
								{
									"key": "prefix",
									"value": "respone/"
								},
								{
									"key": "max-keys",
									"value": "50"
								}
							]
						},
						"description": "List farmer-data webhook payloads under `respone/` after consent approval.\n\nBrowser alternative: http://a2c-webhook.s3-website.ap-south-1.amazonaws.com/respone/"
					},
					"response": []
				},
				{
					"name": "D. fetch latest farmer webhook",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Farmer webhook HTTP 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"const payload = pm.response.json();",
									"pm.test('Farmer webhook has consent block', function () {",
									"    pm.expect(payload).to.have.property('consent');",
									"    pm.expect(payload).to.have.property('farmer');",
									"    pm.expect(payload).to.have.property('selected_data');",
									"});"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{webhook_response_url}}/{{latest_farmer_webhook_key}}",
							"host": [
								"{{webhook_response_url}}"
							],
							"path": [
								"{{latest_farmer_webhook_key}}"
							]
						},
						"description": "Fetch the newest farmer-data webhook JSON published after consent approval."
					},
					"response": []
				}
			]
		}
	],
